# PodReader Environment Variables
# Copy this file to .env and fill in the values.

# Required: API keys for transcription and summarisation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required: Secret for session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: Comma-separated list of allowed CORS origins.
# Defaults to http://localhost:5173,http://localhost:3001 if not set.
CORS_ORIGIN=

# Optional: Path to SQLite database file.
# Defaults to /var/lib/podreader/podreader.db
# DB_PATH=
